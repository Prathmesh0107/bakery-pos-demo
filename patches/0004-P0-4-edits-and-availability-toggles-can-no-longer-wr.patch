--- a/static/index.html
+++ b/static/index.html
@@ -192,13 +192,13 @@ function invR(){const s=iq.toLowerCase(),l=S.products.filter(p=>(ic=='All'||p.ca
 $('iq').oninput=e=>{iq=e.target.value;const p=e.target.selectionStart;invR();$('iq').focus();$('iq').setSelectionRange(p,p)};$('lo').onclick=()=>{lowOnly=!lowOnly;invR()};
 for(const b of document.querySelectorAll('.chips button'))b.onclick=()=>{ic=b.dataset.c;invR()};
 $('rows').onclick=e=>{const b=e.target.closest('button');if(!b)return;const id=+b.closest('.sr').dataset.id,a=b.dataset.a;if(a=='e')edit(id);else if(a=='o')stockM(id);else if(a=='t')tog(id);else adj(id,{add:+a})};loadLog()}
