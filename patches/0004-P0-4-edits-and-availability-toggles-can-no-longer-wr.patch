 /* ---------- sales ---------- */
 function salesR(){const d=dsel||dk(Date.now()),s=S.sales.filter(x=>dk(x.t)==d),t=s.reduce((a,x)=>a+x.total,0),pm={Cash:0,UPI:0,Card:0},tp={};s.forEach(x=>{Object.entries(x.payments||{[x.pay]:x.total}).forEach(([k,v])=>pm[k]=(pm[k]||0)+v);x.items.forEach(i=>tp[i.name]=(tp[i.name]||0)+i.q)});const top=Object.entries(tp).sort((a,b)=>b[1]-a[1]).slice(0,5);
