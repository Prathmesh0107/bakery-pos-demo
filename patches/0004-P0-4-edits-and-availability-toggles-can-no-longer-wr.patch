+async function adj(id,body){try{const p=await api('/products/'+id+'/stock',{method:'POST',body:JSON.stringify(body)});Object.assign(P(id),p);if(view=='inv'){const r=document.querySelector(`.sr[data-id="${id}"]`);if(r)r.outerHTML=rowH(P(id));loadLog()}closeM();fixCart();toast(p.name+' → '+p.stock+' in stock');return true}catch(e){toast(e.message,1);if(e.status==409){closeM();await load();if(view=='inv')invR()}return false}}
 function stockM(id){const p=P(id);modal(`<h2>${esc(p.name)}</h2><p class="mu">In stock now: <b>${p.stock}</b></p><label>Quantity</label><input id="sq" inputmode="numeric" autocomplete="off"><label>Note (optional)</label><input id="sn" maxlength="60" placeholder="e.g. fresh batch, counted, damaged"><div class="row" style="margin-top:12px"><button class="pri" style="flex:1;background:var(--ok);border-color:var(--ok)" id="s1">+ Add</button><button style="flex:1" id="s2">− Remove</button><button style="flex:1" id="s3">Set to</button></div><button style="width:100%;margin-top:10px" onclick="closeM()">Cancel</button>`);$('sq').oninput=e=>e.target.value=e.target.value.replace(/\D/g,'');const g=()=>{const v=$('sq').value;if(v==='')return null;return Number(v)};const n=()=>$('sn').value.trim()||undefined;
-$('s1').onclick=()=>{const v=g();v!=null&&adj(id,{add:v,note:n()})};$('s2').onclick=()=>{const v=g();v!=null&&adj(id,{add:-v,note:n()})};$('s3').onclick=()=>{const v=g();v!=null&&adj(id,{set_to:v,note:n()||'manual count'})};setTimeout(()=>$('sq').focus(),50)}
