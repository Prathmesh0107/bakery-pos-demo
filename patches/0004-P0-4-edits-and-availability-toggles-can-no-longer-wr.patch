-try{await api(id?'/products/'+id:'/products',{method:id?'PUT':'POST',body:JSON.stringify({name:n,cat:c,price:pr,stock:st,on:$('eo').checked,image:$('ei').value.trim()||null})});await load();fixCart();closeM();invR();top_();toast('Product saved')}catch(x){e.textContent=x.message}}
+$('s1').onclick=()=>{const v=g();v!=null&&adj(id,{add:v,note:n()})};$('s2').onclick=()=>{const v=g();v!=null&&adj(id,{add:-v,note:n()})};$('s3').onclick=()=>{const v=g();v!=null&&adj(id,{set_to:v,expected:p.stock,note:n()||'manual count'})};setTimeout(()=>$('sq').focus(),50)}
+async function tog(id){const p=P(id);try{await api('/products/'+id+'/availability',{method:'PATCH',body:JSON.stringify({on:!p.on})});await load();fixCart();invR();toast(p.name+(p.on?' hidden':' available'))}catch(e){toast(e.message,1)}}
+function edit(id){const p=id?P(id):{name:'',cat:S.categories[0]||'',price:'',stock:'',on:true,image:''};modal(`<h2 style="margin:0 0 6px">${id?'Edit':'New'} product</h2><label>Name</label><input id="en" value="${esc(p.name)}"><label>Category (pick or type a new one)</label><input id="ec" list="cl" value="${esc(p.cat)}"><datalist id="cl">${S.categories.map(c=>`<option value="${esc(c)}">`).join('')}</datalist><label>Price (₹)</label><input id="ep" inputmode="numeric" value="${p.price}">${id?`<p class="mu">Stock now: <b>${p.stock}</b>. Change stock with +5 / Other… on the Stock screen so every change is logged.</p>`:`<label>Opening stock</label><input id="es" inputmode="numeric" value="${p.stock}">`}<label>Image link (optional)</label><input id="ei" value="${esc(p.image||'')}" placeholder="https://… or /static/…"><label style="display:flex;gap:8px;align-items:center;color:var(--tx)"><input type="checkbox" id="eo" style="width:26px;min-height:26px" ${p.on?'checked':''}> Available for sale</label><p id="er" class="bad"></p><div class="row"><button style="flex:1" onclick="closeM()">Cancel</button><button class="pri" style="flex:1" onclick="saveP(${id})">Save</button></div>`)}
+async function saveP(id){const n=$('en').value.trim(),c=$('ec').value.trim(),pr=Number($('ep').value),st=$('es')?Number($('es').value):0,e=$('er');if(!n)return e.textContent='Enter a product name.';if(!c)return e.textContent='Enter a category.';if($('ep').value.trim()===''||!Number.isInteger(pr)||pr<0)return e.textContent='Price must be a whole number of rupees.';if($('es')&&($('es').value.trim()===''||!Number.isInteger(st)||st<0))return e.textContent='Stock must be a whole number, 0 or more.';
